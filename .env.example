# Aetheron Premium E-Commerce Environment Variables

# JWT Secret used for signing authentication tokens
JWT_SECRET=aetheron_super_secret_2026

# Administrator user seeding credentials
ADMIN_EMAIL=admin@aetheron.com
ADMIN_PASSWORD=admin123

# Path to the SQLite database
DATABASE_PATH=./db/aetheron.sqlite

# Google Gemini API key for AI Chatbot features (optional)
# GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Development options
# DISABLE_HMR="false"
